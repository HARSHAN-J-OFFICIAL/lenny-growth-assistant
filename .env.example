# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration Template
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT:
# - NEVER commit your actual .env file or production secrets to Git.
# - Mandatory Local Setup requires NO paid API keys. All core workflows run
#   100% locally via Ollama and Docker PostgreSQL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Metadata & Server Flags
# ------------------------------------------------------------------------------
PROJECT_NAME="The Lenny Growth Assistant"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
API_V1_PREFIX="/api/v1"

# ------------------------------------------------------------------------------
# 2. Database Persistence (PostgreSQL 16)
# ------------------------------------------------------------------------------
# PostgreSQL credentials for Docker service
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_dev_password"
POSTGRES_DB="lenny_assistant"
POSTGRES_PORT=5432

# Connection string for Native Windows development:
DATABASE_URL="postgresql+asyncpg://postgres:postgres_dev_password@localhost:5432/lenny_assistant"

# Connection string when running inside Docker Compose:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres_dev_password@db:5432/lenny_assistant"

# Zero-configuration SQLite fallback (if PostgreSQL is unavailable):
# DATABASE_URL="sqlite+aiosqlite:///./lenny_assistant.db"

# ------------------------------------------------------------------------------
# 3. Local LLM Configuration (Ollama - MANDATORY FOR LOCAL EVALUATION)
# ------------------------------------------------------------------------------
# For Native Windows development (accessing Ollama on host):
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# For Docker Compose containers (reaching host Ollama from inside Docker):
OLLAMA_DOCKER_URL="http://host.docker.internal:11434"

# Primary local model (pulled via `ollama run llama3.2`):
OLLAMA_DEFAULT_MODEL="llama3.2"

# Secondary lightweight model for provider switching:
OLLAMA_LIGHTWEIGHT_MODEL="qwen2.5:1.5b"

# ------------------------------------------------------------------------------
# 4. Official Pi Coding Agent Service
# ------------------------------------------------------------------------------
# URL for FastAPI to communicate with the Node.js Pi SDK daemon:
# Native Windows:
AGENT_SERVICE_URL="http://127.0.0.1:8001"
# Docker Compose:
# AGENT_SERVICE_URL="http://agent:8001"

# Port on which the Pi Agent HTTP service listens:
AGENT_SERVICE_PORT=8001

# URL for Pi Agent to call back into FastAPI for transcript retrieval:
FASTAPI_URL="http://127.0.0.1:8000"

# ------------------------------------------------------------------------------
# 5. Frontend & CORS Configuration
# ------------------------------------------------------------------------------
# Permitted cross-origin origins for the FastAPI backend:
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://127.0.0.1:80"

# Frontend API Base URL:
# Native development:
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
# Docker deployment with NGINX reverse proxy:
# VITE_API_BASE_URL="/api/v1"

# ------------------------------------------------------------------------------
# 6. Knowledge Base & Hybrid Retrieval Paths
# ------------------------------------------------------------------------------
# Directory containing the cloned Lenny podcast transcripts:
TRANSCRIPTS_DATA_DIR="./data/transcripts"

# Directory where pre-computed vector & BM25 indexes are stored:
INDICES_STORAGE_DIR="./data/indices"

# FastEmbed dense embedding model:
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"

# RRF (Reciprocal Rank Fusion) parameters:
RRF_K=60
EVIDENCE_THRESHOLD=0.012
DEFAULT_TOP_K=5

# ------------------------------------------------------------------------------
# 7. Cloud LLM Providers (OPTIONAL - Leave blank for local evaluation)
# ------------------------------------------------------------------------------
# When left empty, the application automatically routes cloud requests to
# local Ollama with a transparent notice banner. Live cloud testing will be
# marked as pending until valid API keys are supplied.
OPENAI_API_KEY=""
OPENAI_DEFAULT_MODEL="gpt-4o"

ANTHROPIC_API_KEY=""
# Currently supported Anthropic models:
# - claude-sonnet-4-6 (Flagship default: reasoning & coding)
# - claude-haiku-4-5  (Lightweight & cost-efficient tier)
ANTHROPIC_DEFAULT_MODEL="claude-sonnet-4-6"

# ------------------------------------------------------------------------------
# 8. Groq Cloud Provider (Free-Tier High-Speed Inference - OPTIONAL)
# ------------------------------------------------------------------------------
# Groq provides ultra-fast cloud inference on Groq LPUs with a free API tier.
# Get a free API key at https://console.groq.com/keys
# Supported models include:
# - openai/gpt-oss-20b (Default: open-weight MoE reasoning model, 131k context)
# - llama-3.3-70b-versatile (Flagship open intelligence on Groq LPU)
# - llama-3.1-8b-instant (Ultra-low latency model on Groq LPU)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
